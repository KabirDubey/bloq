7: XZZ [1, 1, 1]
8: XZZ [1, 1, 2]
9: Port [1, 1, 3] <Out_Target>
[0, 0, 0] -> +Z
[0, 0, 1] -> +Z
[0, 0, 1] -> +X
[0, 0, 2] -> +Z
[1, 0, 1] -> +Z
[1, 0, 2] -> +Y
[1, 1, 0] -> +Z
